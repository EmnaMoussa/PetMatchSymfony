{% extends 'base.html.twig' %}

{% block title %}Matches - PetMatch{% endblock %}

{% block body %}
<section>
    <h2>Mes Matches</h2>
    <p>Les matches avec de vrais profils apparaitront ici.</p>

    <div id="liste-matches">
        {% for match in matches %}
            <div class="match-card">
                <img src="{{ asset(match.pet.photo starts with 'uploads/' ? match.pet.photo : 'images/' ~ match.pet.photo) }}" alt="{{ match.pet.nom }}">
                <div class="match-info">
                    <h3>{{ match.ownerPet.nom }} et {{ match.pet.nom }}</h3>
                    <p>{{ match.pet.owner.fullName }}</p>
                    <p class="match-date">{{ match.createdAt|date('d/m/Y H:i') }}</p>
                    <a class="btn-primary" href="{{ path('app_chat', {id: match.id}) }}">Chat</a>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if matches is empty %}
        <div id="msg-aucun-match" class="empty-state">
            Tu n'as pas encore de matches.
            <a href="{{ path('app_swipe') }}">Continuer a swiper</a>
        </div>
    {% endif %}
</section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Matches - PetMatch{% endblock %}

{% block body %}
<section class="panel">
    <div class="section-heading">
        <div>
            <h1>Mes matches</h1>
            <p class="muted">{{ matchCount }} match{{ matchCount > 1 ? 's' : '' }} actif{{ matchCount > 1 ? 's' : '' }}</p>
        </div>
        <a class="button" href="{{ path('app_swipe') }}">Continuer a swiper</a>
    </div>

    <div class="pet-list">
        {% for match in matches %}
            <article class="pet-row">
                <img class="pet-avatar image" src="{{ asset(match.pet.photo starts with 'uploads/' ? match.pet.photo : 'images/' ~ match.pet.photo) }}" alt="{{ match.pet.nom }}">
                <div>
                    <strong>{{ match.ownerPet.nom }} et {{ match.pet.nom }}</strong>
                    <span>{{ match.pet.owner.fullName }} - {{ match.createdAt|date('d/m/Y H:i') }}</span>
                </div>
                <a class="button small" href="{{ path('app_chat', {id: match.id}) }}">Chat</a>
            </article>
        {% else %}
            <p class="muted">Aucun match pour le moment. Un match apparait quand deux proprietaires disent oui sur l'animal de l'autre.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}

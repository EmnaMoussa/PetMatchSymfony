{% extends 'base.html.twig' %}

{% block title %}Profil - PetMatch{% endblock %}

{% block body %}
<section>
    <h2>Mon Profil</h2>

    <div class="profil-layout">
    <article class="profil-card">
        {% if pet.id %}
            <img src="{{ asset(pet.photo ? (pet.photo starts with 'uploads/' ? pet.photo : 'images/' ~ pet.photo) : 'images/default-profile.svg') }}" alt="photo de profil" width="300" height="300">
        {% endif %}
        <h3>{{ pet.id ? user.prenom ~ ' ' ~ user.nom : 'Profil vide' }}</h3>
        <p>{{ pet.id ? pet.nom ~ ' - ' ~ pet.espece|capitalize : 'Completez le formulaire pour creer votre profil.' }}</p>
        <p>{{ user.ville }}</p>
        <p>{{ pet.bio }}</p>
        <div class="pet-list">
            {% for ownedPet in pets %}
                <a class="animal-chip {{ pet.id and ownedPet.id == pet.id ? 'active' : '' }}" href="{{ path('app_profile', {animal: ownedPet.id}) }}">
                    {{ ownedPet.nom }} <span>{{ ownedPet.race ?: ownedPet.espece }}</span>
                </a>
            {% else %}
                <p class="muted">Ajoutez votre premier animal pour commencer.</p>
            {% endfor %}
        </div>
        <br>
        <span class="profil-badge">{{ pets|length }} animal{{ pets|length > 1 ? 's' : '' }}</span>
    </article>

    <article class="profil-edit-form">
        <h3>Modifier le profil</h3>
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_save') }}">
            <input type="hidden" name="pet_id" value="{{ pet.id }}">
            <fieldset>
                <legend>Informations du proprietaire</legend>
                <div class="form-grid">
                    <div class="form-group"><label>Prenom</label><input name="prenom" value="{{ user.prenom }}" required></div>
                    <div class="form-group"><label>Nom</label><input name="nom" value="{{ user.nom }}" required></div>
                    <div class="form-group"><label>Email</label><input type="email" name="email" value="{{ user.email }}" required></div>
                    <div class="form-group"><label>Ville</label><input name="ville" value="{{ user.ville }}"></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Informations de l'animal</legend>
                <div class="form-group">
                    <label>Animal a modifier</label>
                    <div class="animal-toolbar">
                        <select onchange="if (this.value) window.location.href=this.value">
                            <option value="{{ path('app_profile') }}">Ajouter un animal</option>
                            {% for ownedPet in pets %}
                                <option value="{{ path('app_profile', {animal: ownedPet.id}) }}" {{ pet.id and ownedPet.id == pet.id ? 'selected' : '' }}>{{ ownedPet.nom }}</option>
                            {% endfor %}
                        </select>
                        <a class="btn-outline" href="{{ path('app_profile') }}">Ajouter un animal</a>
                    </div>
                </div>

                <div class="form-group">
                    <label>Photo de l'animal</label>
                    {% if pet.id %}
                        <img class="profile-preview" src="{{ asset(pet.photo ? (pet.photo starts with 'uploads/' ? pet.photo : 'images/' ~ pet.photo) : 'images/default-profile.svg') }}" alt="{{ pet.nom }}">
                    {% endif %}
                    <input type="file" name="photo" accept="image/jpeg,image/png,image/webp">
                </div>

                <div class="form-grid">
                    <div class="form-group"><label>Nom de l'animal</label><input name="pet_nom" value="{{ pet.nom }}" required></div>
                    <div class="form-group">
                        <label>Espece</label>
                        <select name="espece" required>
                            <option value="">Choisir une espece</option>
                            {% for espece in ['chien', 'chat', 'lapin', 'oiseau', 'poisson', 'reptile', 'autre'] %}
                                <option value="{{ espece }}" {{ pet.espece == espece ? 'selected' : '' }}>{{ espece|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group"><label>Race</label><input name="race" value="{{ pet.race }}"></div>
                    <div class="form-group"><label>Age (en annees)</label><input type="number" name="age" value="{{ pet.age }}" min="0" max="30"></div>
                </div>
                <div class="form-group">
                    <label>Sexe de l'animal</label>
                    <div class="radio-group">
                        <label><input type="radio" name="sexe" value="male" {{ pet.sexe in ['male', 'Male'] ? 'checked' : '' }}> Male</label>
                        <label><input type="radio" name="sexe" value="femelle" {{ pet.sexe in ['femelle', 'Femelle'] ? 'checked' : '' }}> Femelle</label>
                    </div>
                </div>
                <div class="form-group"><label>Bio</label><textarea name="bio" placeholder="Decrivez la personnalite de votre animal...">{{ pet.bio }}</textarea></div>
            </fieldset>

            <button type="submit" class="form-submit">Sauvegarder les modifications</button>
        </form>
    </article>
    </div>
</section>
{% endblock %}

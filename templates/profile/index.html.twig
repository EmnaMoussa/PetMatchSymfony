{% extends 'base.html.twig' %}

{% block title %}Profil - PetMatch{% endblock %}

{% block body %}
<section class="profile-layout">
    <article class="card">
        <h1>Mes animaux</h1>
        <div class="pet-list">
            {% for ownedPet in pets %}
                <article class="pet-row {{ pet.id and ownedPet.id == pet.id ? 'active' : '' }}">
                    <div class="pet-avatar">{{ ownedPet.espece|default('animal')|slice(0, 1)|upper }}</div>
                    <div>
                        <strong>{{ ownedPet.nom }}</strong>
                        <span>{{ ownedPet.race ?: ownedPet.espece }} - {{ ownedPet.age ?: '?' }} ans</span>
                    </div>
                    <a class="button small ghost" href="{{ path('app_profile', {animal: ownedPet.id}) }}">Modifier</a>
                </article>
            {% else %}
                <p class="muted">Ajoutez votre premier animal pour commencer.</p>
            {% endfor %}
        </div>
        <a class="button" href="{{ path('app_profile') }}">Ajouter un animal</a>
    </article>

    <article class="panel">
        <h1>{{ pet.id ? 'Modifier ' ~ pet.nom : 'Ajouter un animal' }}</h1>
        <form method="post" class="form-grid">
            <input type="hidden" name="pet_id" value="{{ pet.id }}">
            <label>Prenom <input name="prenom" value="{{ user.prenom }}" required></label>
            <label>Nom <input name="nom" value="{{ user.nom }}" required></label>
            <label>Email <input type="email" name="email" value="{{ user.email }}" required></label>
            <label>Ville <input name="ville" value="{{ user.ville }}"></label>
            <label>Nom animal <input name="pet_nom" value="{{ pet.nom }}" required></label>
            <label>Espece <input name="espece" value="{{ pet.espece ?: 'chien' }}"></label>
            <label>Race <input name="race" value="{{ pet.race }}"></label>
            <label>Age <input type="number" name="age" value="{{ pet.age }}" min="0" max="30"></label>
            <label>Sexe <input name="sexe" value="{{ pet.sexe }}"></label>
            <label class="full">Bio <textarea name="bio" rows="4">{{ pet.bio }}</textarea></label>
            <button type="submit">Sauvegarder</button>
        </form>
    </article>
</section>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PetMatch{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}
</head>
<body>
    <header>
        <div><h1>PetMatch</h1></div>
        <div>
            <nav>
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    {% if app.user %}
                        <li><a href="{{ path('app_profile') }}" class="lien-prive">Profil</a></li>
                        <li><a href="{{ path('app_swipe') }}" class="lien-prive">Swipe</a></li>
                        <li>
                            <a href="{{ path('app_matches') }}" class="lien-prive">
                                Matches
                                {% set unreadCount = unread_notifications_count() %}
                                {% if unreadCount > 0 %}
                                    <span class="notif-badge">{{ unreadCount }}</span>
                                {% endif %}
                            </a>
                        </li>
                        <li><a href="{{ path('app_chat_index') }}" class="lien-prive">Chat</a></li>
                    {% endif %}
                    <li><a href="{{ path('app_advice') }}">Conseils</a></li>
                </ul>
            </nav>
        </div>
        <div class="header-auth">
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="btn-outline">Deconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-outline">Connexion</a>
                <a href="{{ path('app_signup') }}" class="btn-primary">S'inscrire</a>
            {% endif %}
        </div>
    </header>

    <main>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash {{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
        {% block body %}{% endblock %}
    </main>

    <footer>
        <div>Adoptez, aimez, protegez - PetMatch</div>
        <div>
            <a href="{{ path('app_advice') }}">Conseils</a>
            <a href="{{ path('app_privacy') }}">Confidentialite</a>
            <a href="{{ path('app_contact') }}">Contact</a>
        </div>
        <div><p>2026</p></div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>

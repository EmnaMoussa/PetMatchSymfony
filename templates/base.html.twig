<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PetMatch{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}
</head>
<body>
    <header class="topbar">
        <a class="brand" href="{{ path('app_home') }}">PetMatch</a>
        <nav>
            <a href="{{ path('app_home') }}">Accueil</a>
            {% if app.user %}
                <a href="{{ path('app_profile') }}">Profil</a>
                <a href="{{ path('app_swipe') }}">Swipe</a>
                <a href="{{ path('app_matches') }}">
                    Matches
                    {% set unreadCount = unread_notifications_count() %}
                    {% if unreadCount > 0 %}
                        <span class="badge">{{ unreadCount }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('app_chat_index') }}">Chat</a>
                <a href="{{ path('app_advice') }}">Conseils</a>
                <a href="{{ path('app_logout') }}">Deconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}">Se connecter</a>
                <a href="{{ path('app_signup') }}">S'inscrire</a>
            {% endif %}
            <a href="{{ path('app_contact') }}">Contact</a>
        </nav>
    </header>

    <main>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash {{ type }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}

        {% block content %}{% endblock %}
        {% block body %}{% endblock %}
    </main>

    <footer>
        <p>PetMatch - cree par Emna Moussa</p>
        <div class="footer-links">
            <a href="{{ path('app_advice') }}">Conseils</a>
            <a href="{{ path('app_contact') }}">Contact</a>
            <a href="{{ path('app_privacy') }}">Confidentialite</a>
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>

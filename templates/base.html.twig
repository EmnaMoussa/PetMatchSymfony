<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PetMatch - Find Your Pet's Perfect Friend{% endblock %}</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <a href="{{ path('home') }}">🐾 PetMatch</a>
            </div>
            <ul class="nav-menu">
                {% if app.user %}
                    <li><a href="{{ path('dashboard') }}">Dashboard</a></li>
                    <li><a href="{{ path('swipe') }}">Swipe</a></li>
                    <li><a href="{{ path('matches') }}">Matches</a></li>
                    <li><a href="{{ path('chat') }}">Chat</a></li>
                    <li><a href="{{ path('advice') }}">Advice</a></li>
                    <li><a href="{{ path('profile') }}">Profile</a></li>
                    <li><a href="{{ path('logout') }}">Logout</a></li>
                {% else %}
                    <li><a href="{{ path('login') }}">Login</a></li>
                    <li><a href="{{ path('register') }}">Register</a></li>
                {% endif %}
                <li><a href="{{ path('contact') }}">Contact</a></li>
            </ul>
        </div>
    </nav>

    <main class="main-content">
        {% if app.flashes %}
            <div class="alerts-container">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }}">
                            {{ message }}
                            <button class="alert-close" onclick="this.parentElement.style.display='none';">×</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        {% block content %}{% endblock %}
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-section">
                <h3>PetMatch</h3>
                <p>A social network for pet lovers</p>
            </div>
            <div class="footer-section">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="{{ path('home') }}">Home</a></li>
                    <li><a href="{{ path('advice') }}">Pet Advice</a></li>
                    <li><a href="{{ path('contact') }}">Contact</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Legal</h4>
                <ul>
                    <li><a href="{{ path('privacy') }}">Privacy Policy</a></li>
                    <li><a href="{{ path('terms') }}">Terms of Service</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 PetMatch. All rights reserved. Created by Emna Moussa</p>
        </div>
    </footer>

    {% block javascripts %}
        <script src="{{ asset('js/main.js') }}"></script>
    {% endblock %}
</body>
</html>

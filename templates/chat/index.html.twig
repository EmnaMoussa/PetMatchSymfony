{% extends 'base.html.twig' %}

{% block title %}Chat - PetMatch{% endblock %}

{% block body %}
<section class="chat">
    <aside class="card">
        <h2>Conversations</h2>
        <div class="pet-list">
            {% for item in matches %}
                <a class="pet-row {{ item.id == match.id ? 'active' : '' }}" href="{{ path('app_chat', {id: item.id}) }}">
                    <img class="pet-avatar image" src="{{ asset(item.pet.photo starts with 'uploads/' ? item.pet.photo : 'images/' ~ item.pet.photo) }}" alt="{{ item.pet.nom }}">
                    <div>
                        <strong>{{ item.pet.nom }}</strong>
                        <span>{{ item.ownerPet.nom }} avec {{ item.pet.owner.prenom }}</span>
                    </div>
                </a>
            {% else %}
                <p class="muted">Aucune conversation.</p>
            {% endfor %}
        </div>
    </aside>

    <article class="panel">
        <div class="chat-heading">
            <img class="pet-avatar image" src="{{ asset(pet.photo starts with 'uploads/' ? pet.photo : 'images/' ~ pet.photo) }}" alt="{{ pet.nom }}">
            <div>
                <h1>{{ pet.nom }}</h1>
                <p class="muted">Match avec {{ match.ownerPet.nom }} - {{ pet.owner.fullName }}</p>
            </div>
        </div>

        <div class="messages">
            {% for message in messages %}
                <div class="message {{ message.sender.id == user.id ? 'sent' : 'received' }}">
                    <p>{{ message.content }}</p>
                    <span>{{ message.createdAt|date('d/m/Y H:i') }}</span>
                </div>
            {% else %}
                <p class="muted">Aucun message. Lance la conversation.</p>
            {% endfor %}
        </div>

        <form method="post" class="chat-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('chat_message') }}">
            <input name="message" autocomplete="off" placeholder="Ecrire un message..." required>
            <button type="submit">Envoyer</button>
        </form>
    </article>
</section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Chat - PetMatch{% endblock %}

{% block body %}
<section>
    <div id="chat-container">
        <div id="colonne-gauche">
            <h2>Messages</h2>
            {% for item in matches %}
                <a class="contact {{ item.id == match.id ? 'active' : '' }}" href="{{ path('app_chat', {id: item.id}) }}">
                    <img src="{{ asset(item.pet.photo ? (item.pet.photo starts with 'uploads/' ? item.pet.photo : 'images/' ~ item.pet.photo) : 'images/default-profile.svg') }}" alt="{{ item.pet.nom }}">
                    <div>
                        <h5>{{ item.pet.nom }}</h5>
                        <p>{{ item.ownerPet.nom }} avec {{ item.pet.owner.prenom }}</p>
                    </div>
                </a>
            {% else %}
                <div class="empty-state">Aucune conversation.</div>
            {% endfor %}
        </div>

        <div id="colonne-droite">
            <div id="chat-header">
                <img src="{{ asset(pet.photo ? (pet.photo starts with 'uploads/' ? pet.photo : 'images/' ~ pet.photo) : 'images/default-profile.svg') }}" alt="{{ pet.nom }}">
                <div>
                    <h3>{{ pet.nom }}</h3>
                    <p id="conv-sous-titre">Match avec {{ match.ownerPet.nom }} - {{ pet.owner.fullName }}</p>
                </div>
            </div>

            <div id="zone-messages">
                {% for message in messages %}
                    <div class="msg {{ message.sender.id == user.id ? 'envoye' : 'recu' }}">
                        <div class="msg-bulle">
                            <p>{{ message.content }}</p>
                            <span class="msg-heure">{{ message.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                    </div>
                {% else %}
                    <div class="empty-state">Aucun message. Lance la conversation.</div>
                {% endfor %}
            </div>

            <div id="chat-input">
                <form method="post" style="display:flex; gap:0.5rem; width:100%;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('chat_message') }}">
                    <input name="message" autocomplete="off" placeholder="Ecrire un message..." required>
                    <button type="submit">Envoyer</button>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}

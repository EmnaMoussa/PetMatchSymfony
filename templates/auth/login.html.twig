{% extends 'base.html.twig' %}

{% block title %}Connexion - PetMatch{% endblock %}

{% block content %}
<section class="auth-page">
    <div class="page-intro">
        <h2>Connexion</h2>
        <p>Connectez-vous pour acceder a votre profil, vos swipes et vos matches.</p>
    </div>
    <form method="post" class="auth-form">
        {% if error %}
            <p class="flash error full">Email ou mot de passe incorrect.</p>
        {% endif %}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="form-group"><label>Email</label><input type="email" name="email" value="{{ last_username|default('') }}" required></div>
        <div class="form-group"><label>Mot de passe</label><input type="password" name="password" required></div>
        <div class="inline-check"><input type="checkbox" name="_remember_me" id="remember"><label for="remember">Se souvenir de moi</label></div>
        <button type="submit">Se connecter</button>
    </form>
    <p class="form-link">Pas encore de compte ? <a href="{{ path('app_signup') }}">Inscription</a></p>
</section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Swipe - PetMatch{% endblock %}

{% block body %}
<section class="panel">
    <div class="section-heading">
        <div>
            <h1>Swipe</h1>
            <p class="muted">Les profils proposes sont filtres automatiquement sur l'espece de l'animal choisi.</p>
        </div>
        <a class="button ghost" href="{{ path('app_profile') }}">Gerer mes animaux</a>
    </div>

    <div class="pet-list">
        {% for userPet in userPets %}
            <a class="pet-row {{ userPet.id == activePet.id ? 'active' : '' }}" href="{{ path('app_swipe', {animal: userPet.id}) }}">
                <img class="pet-avatar image" src="{{ asset(userPet.photo starts with 'uploads/' ? userPet.photo : 'images/' ~ userPet.photo) }}" alt="{{ userPet.nom }}">
                <div>
                    <strong>{{ userPet.nom }}</strong>
                    <span>{{ userPet.espece|capitalize }} - {{ userPet.race ?: 'Race non precisee' }}</span>
                </div>
            </a>
        {% endfor %}
    </div>
</section>

<section class="grid swipe-grid">
    {% for pet in pets %}
        <article class="card swipe-card">
            <img class="pet-image large" src="{{ asset(pet.photo starts with 'uploads/' ? pet.photo : 'images/' ~ pet.photo) }}" alt="{{ pet.nom }}">
            <h2>{{ pet.nom }}</h2>
            <p class="muted">{{ pet.espece|capitalize }} - {{ pet.race ?: 'Race non precisee' }} - {{ pet.age ?: '?' }} ans</p>
            <p>{{ pet.bio ?: 'Aucune description pour le moment.' }}</p>
            <p class="muted">Proprietaire: {{ pet.owner.fullName }}{% if pet.ville %} - {{ pet.ville }}{% endif %}</p>
            <form method="post" class="inline-actions">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('swipe_action') }}">
                <input type="hidden" name="owner_pet_id" value="{{ activePet.id }}">
                <input type="hidden" name="pet_id" value="{{ pet.id }}">
                <button class="ghost" type="submit" name="decision" value="skip">Passer</button>
                <button type="submit" name="decision" value="like">Oui</button>
            </form>
        </article>
    {% else %}
        <article class="panel">
            <h2>Aucun profil disponible</h2>
            <p class="muted">{{ activePet.nom }} a deja vu tous les profils {{ activePet.espece }} disponibles. Les memes profils ne recommencent pas.</p>
        </article>
    {% endfor %}
</section>
{% endblock %}

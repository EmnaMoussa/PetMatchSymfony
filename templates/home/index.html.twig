{% extends 'base.html.twig' %}

{% block title %}PetMatch - Accueil{% endblock %}

{% block body %}
<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Rencontres pour animaux</p>
        <h2>PetMatch</h2>
        <p>
            Creez le profil de votre animal, decouvrez des compagnons compatibles,
            matchez et discutez avec leurs proprietaires.
        </p>
        <div class="actions-row">
            {% if user %}
                <a class="btn-primary" href="{{ path('app_swipe') }}">Commencer a swiper</a>
                <a class="btn-outline" href="{{ path('app_profile') }}">Mon profil</a>
            {% else %}
                <a class="btn-primary" href="{{ path('app_signup') }}">Creer un profil</a>
                <a class="btn-outline" href="{{ path('app_login') }}">Se connecter</a>
            {% endif %}
        </div>
    </div>
    <img src="{{ asset('images/animaux.jpg') }}" alt="Animaux de compagnie" width="1000" height="320">

    <div class="features">
        <div class="feature-card">
            <h3>Profil clair</h3>
            <p>Ajoutez les informations essentielles de votre animal: espece, race, age, ville et bio.</p>
        </div>
        <div class="feature-card">
            <h3>Swipe simple</h3>
            <p>Parcourez les profils disponibles et choisissez les animaux qui pourraient correspondre.</p>
        </div>
        <div class="feature-card">
            <h3>Matches reels</h3>
            <p>Un match apparait uniquement quand deux proprietaires se likent mutuellement.</p>
        </div>
        <div class="feature-card">
            <h3>Discussion</h3>
            <p>Apres un match, utilisez le chat pour organiser une rencontre dans un lieu adapte.</p>
        </div>
    </div>
</section>
{% endblock %}
